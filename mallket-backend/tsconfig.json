{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],  // ✅ Added
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src", "prisma"],  // ✅ Include prisma directory for seed.ts
  "exclude": ["node_modules", "dist"]
}
