// Complete E-commerce Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models
model User {
  id            String        @id @default(uuid())
  firstName     String
  lastName      String
  email         String        @unique @db.VarChar(255)
  password      String        @db.VarChar(255) // Hashed password storage
  role          Role?         @relation(fields: [roleId], references: [id])
  roleId        String?
  addresses     Address[]     @relation(onDelete: Cascade)
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  payments      Payment[]
  reviews       Review[]
  notifications Notification[]
  emailVerified   Boolean      @default(false)
  verifyToken     String?  @db.VarChar(64)
  verifyExpires   DateTime?
  resetToken      String?  @db.VarChar(64)
  resetExpires    DateTime?
  loginAttempts   Int          @default(0)
  lockedUntil     DateTime?
  lastLogin       DateTime?
  lastPasswordChange DateTime? // Track password changes
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  sessions        Session[]
  provider      AuthProvider @default(LOCAL)
  providerId    String?      // ID from third-party provider
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([email])
  @@index([resetToken])
  @@index([verifyToken])
  @@index([createdAt])
}


model Session {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  token        String     @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  @@index([token])
  @@index([expiresAt])
  @@index([userId])
}

model VerificationToken {
  id          String     @id @default(uuid())
  identifier  String     // Typically email
  token       String     @unique
  expires     DateTime
  createdAt   DateTime   @default(now())

  @@index([identifier, token])
}


enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Product Structure
model Product {
  id              String             @id @default(uuid())
  name            String
  description     String?
  basePrice       Float              @min(0)
  categories      Category[]
  attributes      ProductAttribute[]
  variants        ProductVariant[]
  images          String[]
  inventoryLogs   InventoryLog[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  discountCoupons Coupon[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  parentId  String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime  @default(now())
}

// Attribute System for Variants
model Attribute {
  id        String             @id @default(uuid())
  name      String             @unique // "Color", "Size", etc.
  values    AttributeValue[]
  products  ProductAttribute[]
  createdAt DateTime           @default(now())
}

model AttributeValue {
  id          String      @id @default(uuid())
  value       String      // "Red", "XL", etc.
  attribute   Attribute   @relation(fields: [attributeId], references: [id])
  attributeId String
  products    ProductAttribute[]
  createdAt   DateTime    @default(now())
}

model ProductAttribute {
  id              String         @id @default(uuid())
  product         Product        @relation(fields: [productId], references: [id])
  productId       String
  attribute       Attribute      @relation(fields: [attributeId], references: [id])
  attributeId     String
  attributeValue  AttributeValue @relation(fields: [attributeValueId], references: [id])
  attributeValueId String
  createdAt       DateTime       @default(now())
}

// Inventory Management
model InventoryLog {
  id          String    @id @default(uuid())
  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   String?
  quantity    Int       // Positive for stock in, negative for stock out
  type        String    // "purchase", "sale", "return", "adjustment"
  referenceId String?   // Link to order/other system
  createdAt   DateTime  @default(now())
}

// Order System
model Order {
  id           String      @id @default(uuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  items        OrderItem[] @relation(onDelete: Cascade)
  shipping     Shipping    @relation(fields: [shippingId], references: [id])
  shippingId   String
  payment      Payment?
  coupon       Coupon?     @relation(fields: [couponId], references: [id])
  couponId     String?
  status       OrderStatus @default(PENDING)
  total        Float
  subtotal     Float
  tax          Float
  refunds      Refund[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
  quantity  Int
  price     Float    // Snapshot of price at time of purchase
  createdAt DateTime @default(now())
}

// Payment & Refunds
model Payment {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  method      String   // "credit_card", "paypal", etc.
  amount      Float
  transaction String?  // External transaction ID
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Refund {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  amount      Float
  reason      String?
  status      String   @default("requested")
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

// Shipping
model Shipping {
  id           String    @id @default(uuid())
  order        Order     @relation(fields: [orderId], references: [id])
  orderId      String
  address      Address   @relation(fields: [addressId], references: [id])
  addressId    String
  method       ShippingMethod @relation(fields: [methodId], references: [id])
  methodId     String
  trackingCode String?
  status       String    @default("processing")
  cost         Float
  estimatedDelivery DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
}

model ShippingMethod {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  isActive    Boolean   @default(true)
  minDays     Int
  maxDays     Int
  createdAt   DateTime  @default(now())
}

// Coupons & Discounts
model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique
  description  String?
  discountType String     // "percentage" or "fixed"
  value        Float
  minOrder     Float?     @default(0)
  startDate    DateTime
  endDate      DateTime?
  maxUses      Int?
  usedCount    Int        @default(0)
  isActive     Boolean    @default(true)
  products     Product[]
  categories   Category[]
  orders       Order[]
  createdAt    DateTime   @default(now())
}

// Wishlist
model Wishlist {
  id        String         @id @default(uuid())
  user      User           @relation(fields: [userId], references: [id])
  userId    String         @unique
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id          String   @id @default(uuid())
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id])
  wishlistId  String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   String?
  createdAt   DateTime @default(now())
}

// Reviews
model Review {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  rating      Int      @min(1) @max(5)
  title       String?
  comment     String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Notifications
model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String   // "order", "promotion", "system"
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // URL to related resource
  createdAt DateTime @default(now())
}

// Address
model Address {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean   @default(false)
  orders     Order[]
  shipping   Shipping[]
  createdAt  DateTime  @default(now())
}


enum NotificationType {
  ORDER
  PROMOTION
  SYSTEM
  SECURITY
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
}